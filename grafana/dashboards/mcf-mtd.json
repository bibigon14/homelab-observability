      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "bq-billing-export"
          },
          "rawSql": "SELECT sl.value AS namespace, ROUND(SUM(cost), 4) AS cost FROM `dstepanov-gke-platform.billing_export.gcp_billing_export_resource_v1_*`, UNNEST(system_labels) AS sl WHERE DATE(usage_start_time) >= DATE_TRUNC(CURRENT_DATE(\"America/Los_Angeles\"), MONTH) AND sl.key = \"goog-k8s-namespace\" GROUP BY namespace ORDER BY cost DESC LIMIT 15",
          "format": 1,
          "editorMode": "code",
          "location": "US",
          "project": "dstepanov-gke-platform"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "GKE Cost Allocation activated 2026-11-12 09:03 PT.\nFirst-time backfill up to 48h.\nPanel self-populates when goog-k8s-namespace\nsystem_labels appear in Detailed BQ export."
        },
        "overrides": []
      },
