#!/usr/bin/env bash
# Detect and diagnose thanos-compact.service failures on the homelab Pi 5.
#
# DETECTION ONLY since 2026-11-21. The script no longer marks blocks or
# restarts the service. Previous versions set no-downsample-mark.json /
# no-compact-mark.json automatically, which silenced the alert but also
# meant the affected range was never downsampled and was silently deleted
# by raw retention (October 2026 was lost this way). See
# docs/postmortems/2026-11-21-thanos-silent-block-corruption.md.
#
# Detection triggers (unchanged):
#   (1) systemd unit failed (crash-loop past StartLimitBurst)
#   (2) thanos_compact_halted=1 (process alive, internally stopped)
#   (3) thanos_compact_downsample_failures_total increased with a
#       checksum-shaped error in recent logs
#
# On detection: parse the offending block ULID and stage from journalctl,
# decode the block creation time from the ULID, and post ONE alert per
# (block, stage) per 24h to the local telegram-bridge webhook with the
# suggested marker and the trade-off. A human decides what to do.

set -euo pipefail

SERVICE="thanos-compact.service"
METRICS_URL="http://localhost:19194/metrics"
OBJSTORE_CONFIG="/etc/thanos/objstore.yml"
STATE_DIR="/var/lib/thanos-remediate"
BRIDGE_URL="http://localhost:30119/webhook"
DEDUP_SECONDS=86400
TEXTFILE_PATH="/var/lib/prometheus/node-exporter/thanos-remediate.prom"
RUNBOOK_BASE="https://github.com/bibigon14/homelab-observability/blob/main/docs/runbooks/thanos-compact.md"

mkdir -p "$STATE_DIR"

log() { echo "$*" >&2; }

# Write cumulative counter to node_exporter textfile collector.
# Atomic via tmp+mv. result label values:
#   not_needed, reported, already_reported, unidentified,
#   transient_skipped
# Keeps running totals in STATE_DIR; written on every exit path.
write_textfile_metric() {
    local result="$1"
    local counter_file="$STATE_DIR/result_${result}"
    local current
    current=$(cat "$counter_file" 2>/dev/null || echo 0)
    current=$((current + 1))
    echo "$current" > "$counter_file"
    {
        echo "# HELP thanos_compact_auto_remediate_total Total auto-remediation runs by outcome."
        echo "# TYPE thanos_compact_auto_remediate_total counter"
        for f in "$STATE_DIR"/result_*; do
            [ -f "$f" ] || continue
            local r="${f##*/result_}"
            local v
            v=$(cat "$f" 2>/dev/null || echo 0)
            echo "thanos_compact_auto_remediate_total{result=\"${r}\"} ${v}"
        done
        echo "# HELP thanos_compact_auto_remediate_last_run_timestamp_seconds Unix timestamp of last run."
        echo "# TYPE thanos_compact_auto_remediate_last_run_timestamp_seconds gauge"
        echo "thanos_compact_auto_remediate_last_run_timestamp_seconds $(date +%s)"
    } > "${TEXTFILE_PATH}.tmp" 2>/dev/null && mv "${TEXTFILE_PATH}.tmp" "$TEXTFILE_PATH" 2>/dev/null || true
}

# Send an Alertmanager-shaped alert to the bridge.
# args: alertname, severity, summary, description, [runbook_anchor]
# runbook_anchor is appended to RUNBOOK_BASE and sent as annotations.runbook_url.
send_alert() {
    local alertname="$1" severity="$2" summary="$3" description="$4"
    local runbook_anchor="${5:-}"
    local runbook_url="${RUNBOOK_BASE}${runbook_anchor:+#${runbook_anchor}}"
    local ts; ts=$(date -u +%Y-%m-%dT%H:%M:%S.000Z)
    curl -sS --max-time 10 -X POST "$BRIDGE_URL" \
        -H "Content-Type: application/json" \
        -d @- <<PAYLOAD >/dev/null 2>&1 || log "bridge post failed"
{
  "receiver": "telegram-bridge",
  "status": "firing",
  "alerts": [{
    "status": "firing",
    "labels": {
      "alertname": "${alertname}",
      "severity": "${severity}",
      "location": "home",
      "monitor": "homebridge",
      "service": "thanos-compact"
    },
    "annotations": {
      "summary": "${summary}",
      "description": "${description}",
      "runbook_url": "${runbook_url}"
    },
    "startsAt": "${ts}",
    "endsAt": "0001-01-01T00:00:00Z"
  }],
  "version": "4"
}
PAYLOAD
}

# Read a Prometheus metric summed across all label combinations.
# Handles both bare metrics ("name value") and labelled ones ("name{labels} value").
read_metric() {
    local name="$1"
    curl -sS --max-time 5 "$METRICS_URL" 2>/dev/null \
        | grep -E "^${name}( |\{)" \
        | awk '{sum += $NF} END {print int(sum+0)}'
}

# Decode the creation time (unix seconds) from the first 10 chars of a ULID.
ulid_epoch() {
    local alphabet="0123456789ABCDEFGHJKMNPQRSTVWXYZ" u="$1" t=0 i c prefix
    for ((i = 0; i < 10; i++)); do
        c="${u:i:1}"
        prefix="${alphabet%%"$c"*}"
        t=$((t * 32 + ${#prefix}))
    done
    echo $((t / 1000))
}

# One alert per key per DEDUP_SECONDS.
REPORTED_LOG="$STATE_DIR/reported.log"
already_reported() {
    local key="$1" cutoff=$(( $(date +%s) - DEDUP_SECONDS ))
    touch "$REPORTED_LOG"
    awk -v c="$cutoff" '$1 > c' "$REPORTED_LOG" > "$REPORTED_LOG.tmp" && mv "$REPORTED_LOG.tmp" "$REPORTED_LOG"
    grep -qF " $key" "$REPORTED_LOG"
}
remember_reported() { echo "$(date +%s) $1" >> "$REPORTED_LOG"; }

# Strip characters that would break the hand-built JSON payload.
json_safe() { tr -d '"\\' <<<"$1"; }

# --- Decide if attention is needed ---
NEEDS=0; TRIGGER=""; REASON=""

if systemctl is-failed --quiet "$SERVICE"; then
    NEEDS=1; TRIGGER="failed"; REASON="systemd unit failed"
elif systemctl is-active --quiet "$SERVICE"; then
    HALTED=$(read_metric "thanos_compact_halted"); HALTED=${HALTED:-0}
    if [ "$HALTED" -eq 1 ]; then
        NEEDS=1; TRIGGER="halted"; REASON="thanos_compact_halted=1"
    else
        FAILS=$(read_metric "thanos_compact_downsample_failures_total"); FAILS=${FAILS:-0}
        LAST_FILE="$STATE_DIR/last_downsample_failures"
        LAST=$(cat "$LAST_FILE" 2>/dev/null || echo 0)
        if [ "$FAILS" -gt "$LAST" ]; then
            # Guard against transient errors (context canceled, timeout, network).
            # Only trigger remediation when a checksum-shaped error actually
            # appeared in the last tick, otherwise the counter increment is
            # usually a retriable download failure that Thanos recovers from.
            RECENT_ERR=$(journalctl -u "$SERVICE" --since "5 min ago" --no-pager 2>/dev/null \
                | grep -E "level=error|retriable error" | tail -5)
            if echo "$RECENT_ERR" | grep -qiE "checksum|invalid|corrupt|gather index"; then
                NEEDS=1; TRIGGER="downsample_fail"
                REASON="downsample_failures_total: ${LAST} -> ${FAILS}"
            else
                log "downsample_failures_total: ${LAST} -> ${FAILS} but no checksum error in recent logs (likely transient); skipping remediation"
                write_textfile_metric "transient_skipped"
                echo "$FAILS" > "$LAST_FILE"
                exit 0
            fi
        fi
        echo "$FAILS" > "$LAST_FILE"
    fi
fi

if [ "$NEEDS" -eq 0 ]; then
    write_textfile_metric "not_needed"
    exit 0
fi

log "attention needed: $TRIGGER / $REASON"

# --- Identify block and stage from recent logs ---
RECENT_LOG=$(journalctl -u "$SERVICE" --since "1 hour ago" --no-pager 2>/dev/null)

BLOCK_ID=$(echo "$RECENT_LOG" \
    | grep -oE "downsample block [0-9A-Z]{26}" \
    | awk '{print $NF}' | tail -1 || true)
MARKER=""; DETAILS_LINE=""

if [ -n "$BLOCK_ID" ]; then
    MARKER="no-downsample-mark.json"
    DETAILS_LINE=$(echo "$RECENT_LOG" \
        | grep -oE "get chunk [0-9]+, series [0-9]+: checksum mismatch expected:[0-9a-f]+, actual:[0-9a-f]+" \
        | tail -1 || true)
else
    BLOCK_ID=$(echo "$RECENT_LOG" \
        | grep -oE "from block [0-9A-Z]{26}" \
        | awk '{print $NF}' | tail -1 || true)
    if [ -n "$BLOCK_ID" ]; then
        MARKER="no-compact-mark.json"
        DETAILS_LINE=$(echo "$RECENT_LOG" \
            | grep -oE "cannot populate chunk [0-9]+ from block [0-9A-Z]{26}: checksum mismatch expected:[0-9a-fx]+, actual:[0-9a-fx]+" \
            | tail -1 || true)
    else
        # Fallback for Thanos 0.42+ error format: block ID no longer appears in
        # the error line itself (e.g. "input block index not valid: read series:
        # invalid checksum"). Recover it from the preceding "downloaded block
        # id=XXX" line emitted by downsample.go / compact.go before the crash.
        ERR_LINE_NUM=$(echo "$RECENT_LOG" \
            | grep -nE "input block index not valid|invalid checksum|read series" \
            | head -1 | cut -d: -f1 || true)
        if [ -n "$ERR_LINE_NUM" ]; then
            BLOCK_ID=$(echo "$RECENT_LOG" | head -n "$ERR_LINE_NUM" \
                | grep -oE 'msg="downloaded block" id=[0-9A-Z]{26}' \
                | tail -1 | grep -oE "[0-9A-Z]{26}" || true)
            if [ -n "$BLOCK_ID" ]; then
                ERR_LINE=$(echo "$RECENT_LOG" | sed -n "${ERR_LINE_NUM}p")
                if echo "$ERR_LINE" | grep -qiE "downsampling|downsample"; then
                    MARKER="no-downsample-mark.json"
                else
                    MARKER="no-compact-mark.json"
                fi
                DETAILS_LINE=$(echo "$ERR_LINE" \
                    | grep -oE "(first pass of downsampling failed[^\"]*|input block index not valid[^\"]*)" \
                    | head -1 || true)
            fi
        fi

        # Fallback for Thanos 0.42+ compact-stage: when compactor reads a
        # block from local disk (sidecar/store synced it there, no fresh
        # download), there is no preceding "downloaded block id=X" line to
        # walk back to. The block ULID is instead embedded in the local
        # filesystem path within the error itself, e.g.:
        #   "gather index issues for block /var/lib/thanos/compact/compact/0@GROUP/<ULID>: read series: invalid checksum"
        # Extract it from there. compact-stage errors never say "downsample"
        # in this wording, so marker is always no-compact-mark.json.
        if [ -z "$BLOCK_ID" ]; then
            BLOCK_ID=$(echo "$RECENT_LOG" \
                | grep -oE "block /[^ ]+/[0-9A-Z]{26}:" \
                | head -1 | grep -oE "[0-9A-Z]{26}" || true)
            if [ -n "$BLOCK_ID" ]; then
                MARKER="no-compact-mark.json"
                DETAILS_LINE=$(echo "$RECENT_LOG" \
                    | grep -oE "gather index issues[^\\\\]*invalid checksum" \
                    | head -1 || true)
            fi
        fi
    fi
fi

# Validate: BLOCK_ID must be a 26-char ULID (uppercase alphanumeric), not
# a line number or other garbage leaked from an upstream parsing step.
if [ -z "$BLOCK_ID" ] || [ -z "$MARKER" ] \
   || ! echo "$BLOCK_ID" | grep -qE "^[0-9A-Z]{26}$"; then
    KEY="unidentified:${TRIGGER}"
    if already_reported "$KEY"; then
        write_textfile_metric "already_reported"
        exit 0
    fi
    log "cannot identify block ULID / stage from logs"
    send_alert "ThanosCompactNeedsAttention" "critical" \
        "thanos-compact unhealthy, offending block not identified" \
        "Trigger: ${TRIGGER}. Reason: ${REASON}. Detection only: nothing was marked or restarted. Investigate manually." \
        "manual-recovery"
    remember_reported "$KEY"
    write_textfile_metric "unidentified"
    exit 0
fi

if [ "$MARKER" = "no-downsample-mark.json" ]; then STAGE="downsample"; else STAGE="compact"; fi
KEY="${BLOCK_ID}:${STAGE}"
if already_reported "$KEY"; then
    write_textfile_metric "already_reported"
    exit 0
fi

CREATED=$(ulid_epoch "$BLOCK_ID")
CREATED_ISO=$(date -d "@${CREATED}" '+%Y-%m-%d %H:%M %Z')
AGE_H=$(( ( $(date +%s) - CREATED ) / 3600 ))
DETAILS_SAFE=$(json_safe "${DETAILS_LINE:-$REASON}")

log "corrupt block: $BLOCK_ID stage=$STAGE created=$CREATED_ISO age=${AGE_H}h details=$DETAILS_SAFE"

send_alert "ThanosCompactCorruptBlock" "critical" \
    "Block ${BLOCK_ID} fails at ${STAGE} stage" \
    "Block ${BLOCK_ID} (created ${CREATED_ISO}, ${AGE_H}h ago) fails at ${STAGE}: ${DETAILS_SAFE}. Trigger: ${TRIGGER}. Detection only: nothing was marked or restarted. Setting ${MARKER} stops the crash loop, but then the block range is never downsampled and is deleted by raw retention. Decide per runbook." \
    "corrupt-block"

remember_reported "$KEY"
write_textfile_metric "reported"
exit 0
