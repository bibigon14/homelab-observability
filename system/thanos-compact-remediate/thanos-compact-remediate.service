[Unit]
Description=Thanos Compact auto-remediation
Documentation=https://github.com/bibigon14/homelab-observability/blob/main/docs/runbooks/thanos-compact.md

[Service]
Type=oneshot
ExecStart=/usr/local/bin/thanos-compact-auto-remediate
User=root
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/thanos-remediate /var/lib/prometheus/node-exporter
ProtectHome=true
PrivateTmp=true
