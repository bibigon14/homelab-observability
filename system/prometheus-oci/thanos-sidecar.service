[Unit]
Description=Thanos Sidecar (HA replica B, OCI arm64)
Documentation=https://thanos.io/tip/components/sidecar.md/
After=prometheus.service
Requires=prometheus.service

[Service]
# Live-query only since 2026-11-21: no --objstore.config-file, so nothing
# is uploaded to R2. Long-term storage comes from replica A (Pi) alone.
# Previously this sidecar also uploaded with --shipper.upload-compacted,
# which pushed locally compacted level-2 blocks days late and made the
# Pi compactor rebuild history across two lineages.
User=prometheus
Group=prometheus
ExecStart=/opt/thanos/thanos sidecar \
  --tsdb.path=/var/lib/prometheus/metrics2 \
  --prometheus.url=http://localhost:9090 \
  --http-address=0.0.0.0:19191 \
  --grpc-address=0.0.0.0:10901 \
  --log.level=info

Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
