[Unit]
Description=Daily restart of Prometheus (16:00 PDT, staggered from Pi replica at 04:00 PDT)
Documentation=https://github.com/prometheus/prometheus/issues/16074

[Timer]
# 12h stagger from Pi's timer so the HA pair is never both restarting at once.
OnCalendar=*-*-* 16:00:00 America/Los_Angeles
Persistent=true
RandomizedDelaySec=15m

[Install]
WantedBy=timers.target
